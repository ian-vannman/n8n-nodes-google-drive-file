{
  "name": "n8n-nodes-google-drive-file-text",
  "version": "1.0.4",
  "description": "n8n node to fetch Google Drive file metadata and content (Docs as Markdown, Sheets as CSV, Slides as Plain Text)",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "google-drive",
    "metadata",
    "content",
    "markdown",
    "csv"
  ],
  "license": "MIT",
  "homepage": "https://github.com/ian-vannman/n8n-nodes-google-drive-file-text",
  "author": {
    "name": "Ian Vannman",
    "email": "ian@vannman.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ian-vannman/n8n-nodes-google-drive-file-text.git"
  },
  "main": "dist/nodes/GoogleDriveMetadata/GoogleDriveMetadata.node.js",
  "scripts": {
    "build": "tsc && gulp build:icons",
    "dev": "tsc --watch",
    "format": "prettier nodes credentials --write",
    "lint": "tslint -p tsconfig.json -c tslint.json",
    "lintfix": "tslint --fix -p tsconfig.json -c tslint.json",
    "prepublishOnly": "npm run build && npm run lint"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [],
    "nodes": [
      "dist/nodes/GoogleDriveMetadata/GoogleDriveMetadata.node.js"
    ]
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "gulp": "^4.0.2",
    "n8n-core": "^1.0.0",
    "n8n-workflow": "^1.0.0",
    "prettier": "^3.0.0",
    "tslint": "^6.1.3",
    "typescript": "^5.3.0"
  },
  "dependencies": {},
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
